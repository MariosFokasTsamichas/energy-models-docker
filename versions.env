# Pinned upstream sources for the energy-models-workbench image.
#
# Every model is cloned at an exact commit, not a moving branch. To refresh
# the pins, run `make update-pins` (or scripts/update-pins.sh) and rebuild.
#
# PINNED_ON is the date the commits below were resolved. It is metadata only;
# the commits are the source of truth.

PINNED_ON=2026-11-23

PYPSA_EUR_REPO=https://github.com/PyPSA/pypsa-eur.git
PYPSA_EUR_REF=4b2822102a3b4b2c90be1b48bf221a2bb59e0d06

EU_FLEX_REPO=https://github.com/EU-ACER/eu-flex-model.git
EU_FLEX_REF=65cb449bc1ddc3731f542337e1a0e5dbddc35536

OSEMOSYS_REPO=https://github.com/Islam-Dj/Nour-OSeMOSYS-Studio-Standard.git
OSEMOSYS_REF=1602afd56e47d444906f56d7ff5af8951ae87808

# Image name used by the Makefile and docker-compose. Override on the command
# line if you publish under a different account or organisation.
IMAGE_NAME=ghcr.io/mariosfokastsamichas/energy-models-workbench
