# Copy to .env and adjust. `docker compose` reads this file automatically.
#
# Host port for JupyterLab. OSeMOSYS Studio is reachable through JupyterLab at
# /proxy/8775/, so it needs no port of its own.
JUPYTER_PORT=8888

# Leave empty (or delete the line) to let the entrypoint generate a token on
# first start. Set it to pin your own token; set it to "" to disable auth —
# only do that on a machine nobody else can reach.
# JUPYTER_TOKEN=

# Set to 0 to skip the OSeMOSYS Studio server (saves a little memory).
START_OSEMOSYS_STUDIO=1

# Push new model sources and example notebooks into an existing /work volume.
UPDATE_MODELS=0
UPDATE_EXAMPLES=0
